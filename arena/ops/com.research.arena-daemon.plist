<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.research.arena-daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/shipping/.venv/bin/python</string>
    <string>/path/to/shipping/arena/daemon.py</string>
    <string>--challenge</string>
    <string>smoke_min</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/path/to/shipping</string>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/path/to/shipping/state/daemon.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/shipping/state/daemon.launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/path/to/shipping/.venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>ORACLE_STATE_ROOT</key>
    <string>/path/to/shipping/state</string>
  </dict>
</dict>
</plist>
